# Settings for `cargo run` on your own machine. A deployed backend never reads
# this file: the platform sets these variables itself.
GBANDIT_ENVIRONMENT=dev
AUTH_ISSUER=https://auth.gbandit.com
AUTH_AUDIENCE=localhost
AUTH_JWKS_URL=https://auth.gbandit.com/.well-known/jwks.json
DATABASE_URL=sqlite://db.sqlite
