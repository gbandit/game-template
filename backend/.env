# Settings for `cargo run` on your own machine. A deployed backend never reads
# this file: the platform sets these variables itself. The audience is your
# dev environment's, so the backend takes the Test User tokens that
# `bun run dev` fetches with `gbandit test-token`.
AUTH_ISSUER=https://auth.gbandit.com
AUTH_AUDIENCE=game:dev-replace-with-project
AUTH_JWKS_URL=https://auth.gbandit.com/.well-known/jwks.json
DATABASE_URL=sqlite://db.sqlite
